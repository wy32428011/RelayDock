{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "isolatedModules": true,
    "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["apps/desktop/**/*.ts", "apps/desktop/**/*.tsx", "packages/protocol/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts"]
}
