{
  "name": "relaydock",
  "productName": "RelayDock",
  "version": "0.1.3",
  "description": "RelayDock 远程安装工作台",
  "private": true,
  "license": "MIT",
  "author": "RelayDock contributors",
  "type": "module",
  "main": "apps/desktop/dist/main.cjs",
  "workspaces": ["apps/desktop", "packages/protocol"],
  "engines": {"node": "^22.13.0 || >=24.0.0"},
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/launch-desktop.mjs",
    "preview:ui": "vite --config apps/desktop/vite.config.ts --host 127.0.0.1 --strictPort --port 5178",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/desktop/src packages/protocol tests scripts",
    "test:contract": "node --test tests/protocol.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:core:stdio": "node --test tests/core-stdio.test.mjs",
    "test:e2e:packaged": "node tests/desktop-smoke.mjs --packaged",
    "test:e2e:local": "node tests/desktop-smoke.mjs",
    "build": "node scripts/build-app.mjs",
    "build:core": "node scripts/build-core.mjs",
    "package:local": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "jsdom": "28.1.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
